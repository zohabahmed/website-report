# ==============================================================
# Website Maintenance & Upgrade Reporting Tool - Configuration
# ==============================================================

# Server Environment
NODE_ENV=production
PORT=5000

# Security & Authentication
JWT_SECRET=replace_with_a_secure_random_64_char_secret_key_in_production
ADMIN_EMAIL=admin@maintenance.com
ADMIN_PASSWORD=change_this_secure_admin_password_123!

# Database Configuration (Cloudways MySQL / MariaDB)
# Leave DB_CONNECTION=sqlite or leave blank for local file-based database store
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=your_cloudways_dbname
DB_USER=your_cloudways_dbuser
DB_PASSWORD=your_cloudways_dbpassword

# PDF Storage & Output (Optional directory for caching generated PDFs)
PDF_STORAGE_PATH=./data/exports
